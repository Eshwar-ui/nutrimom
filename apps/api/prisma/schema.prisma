// Prisma schema for The Nurture Moms — a preloved baby & maternity marketplace.
// Money is stored as integer paise everywhere — never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER // can buy and sell
  ADMIN
}

enum Condition {
  NEW // new with tags / never used
  LIKE_NEW
  GOOD
  FAIR
}

enum DeliveryOption {
  PICKUP
  DELIVERY
  BOTH
}

enum ListingStatus {
  PENDING // awaiting admin approval
  APPROVED // live and buyable
  REJECTED
  RESERVED // temporarily held for a buyer
  SOLD
}

enum OrderStatus {
  PENDING // created, awaiting payment
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD // RETIRED — retained only so historical orders stay valid; not selectable
  ONLINE // Online gateway (Razorpay/…) — the only method for new orders
}

enum SellerPaymentType {
  REGISTRATION // one-time ₹100 account activation
  MEMBERSHIP // a prepaid plan purchase
}

enum SellerPaymentStatus {
  PENDING // gateway order created, awaiting payment
  PAID // verified/settled
  FAILED
}

enum MembershipPlan {
  MONTHLY // 30 days
  QUARTERLY // 90 days
  HALF_YEARLY // 180 days
  YEARLY // 365 days
}

enum ShipmentStatus {
  PENDING // order paid, seller has not generated a label yet
  LABEL_GENERATED // label created, ready to print + hand over
  SHIPPED // handed to the courier
  DELIVERED
}

enum PayoutStatus {
  PENDING // order paid but still cancellable — not yet owed
  PAYABLE // order delivered — the marketplace owes this seller
  PAID // transferred out, reference recorded
  CANCELLED // order cancelled; the item went back to the seller unsold
}

enum NotificationType {
  LISTING_APPROVED
  LISTING_REJECTED
  ITEM_SOLD // to the seller
  ORDER_PLACED // to the admin
  ORDER_CANCELLED // to the seller
  PAYMENT_REFUNDED // to the buyer
  SELLER_REGISTERED // to the admin, on the ₹100 registration payment
  MEMBERSHIP_EXPIRING // to the seller, before their listing window lapses
  MEMBERSHIP_EXPIRED // to the seller, once it has lapsed
  DONATION_OFFERED // to the admin, when a mother submits a DonationOffer
}

model User {
  id                            String         @id @default(cuid())
  email                         String         @unique
  passwordHash                  String
  name                          String
  role                          Role           @default(CUSTOMER)
  // Seller profile
  whatsappNumber                String?
  city                          String?
  // Seller defaults prefilled into every new listing's location fields. Same
  // privacy rule as Listing: locality is an area, never a house address, and
  // pincode is never shown publicly.
  locality                      String?
  pincode                       String?
  bio                           String?
  isSellerVerified              Boolean        @default(false)
  sellerVerificationRequestedAt DateTime?
  // The built-in "Marketplace" account admin-created listings are attributed
  // to (roadmap 4.1) — not a real seller, never logged into by a person.
  isSystemSeller                Boolean        @default(false)
  // Monetization: ₹100 one-time registration fee gate (paid online). Must be
  // set before a seller can buy a membership plan or create listings.
  registrationPaidAt            DateTime?
  // Bumped to invalidate every refresh token already issued to this user —
  // on password reset, and on an explicit "sign out everywhere". Refresh
  // tokens carry the value they were minted with and are rejected on
  // mismatch. Access tokens are not checked against it (that would mean a DB
  // read per request); their 15-minute TTL is what bounds the window.
  tokenVersion                  Int            @default(0)
  // Personal data is anonymised on account deletion while financial/order
  // records remain referentially intact.
  deletedAt                     DateTime?
  listings                      Listing[]
  orders                        Order[]
  wishlist                      WishlistItem[]
  notifications                 Notification[]
  reviewsWritten                Review[]       @relation("ReviewsWritten")
  reviewsReceived               Review[]       @relation("ReviewsReceived")
  sellerPayments                SellerPayment[]
  memberships                   SellerMembership[]
  payouts                       SellerPayout[]
  passwordResetTokens           PasswordResetToken[]
  donationOffers                DonationOffer[]
  createdAt                     DateTime       @default(now())
}

// Only the SHA-256 hash of the reset token is stored — same principle as a
// password hash — so a DB read alone can't be used to reset an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  listings       Listing[]
  donationOffers DonationOffer[]
}

model Listing {
  id                   String         @id @default(cuid())
  title                String
  description          String
  seller               User           @relation(fields: [sellerId], references: [id])
  sellerId             String
  category             Category       @relation(fields: [categoryId], references: [id])
  categoryId           String
  condition            Condition
  originalPriceInPaise Int? // what the seller paid new
  sellingPriceInPaise  Int
  purchaseDate         DateTime?
  usageDuration        String? // free text, e.g. "6 months"
  reasonForSelling     String?
  city                 String
  // Area or neighbourhood ("Koramangala"), shown publicly as "City · Locality".
  // Never a house address — the seller form says so, and buyers only need it
  // to judge whether a pickup is realistic.
  locality             String?
  // 6-digit Indian PIN, format-checked only (no PIN-to-city lookup). Used for
  // filtering, and NEVER displayed publicly or sent in the public Listing DTO:
  // a PIN plus a locality narrows a seller's home down further than a buyer
  // needs before they've even made contact. Nullable — listings predating the
  // redesign, and anything posted by the mobile app, have none.
  pincode              String?
  deliveryOption       DeliveryOption @default(PICKUP)
  images               String[] // up to 10, enforced in app
  status               ListingStatus  @default(PENDING)
  // Set when status = REJECTED so the seller sees why, not just that.
  // Cleared on the next moderation decision (approve or a fresh reject).
  rejectionReason      String?
  isFeatured           Boolean        @default(false)
  // Optional reservation hold
  reservedById         String?
  reservedUntil        DateTime?
  // The order (if any) currently holding a claim on this listing — set
  // atomically at order-creation so two buyers can never both check out the
  // same item, and checked by settle()/cancel() so only the order that
  // actually holds a listing can flip or release it.
  holdOrder            Order?         @relation("ListingHold", fields: [holdOrderId], references: [id])
  holdOrderId          String?
  orderItems           OrderItem[]
  wishlistedBy         WishlistItem[]
  reviews              Review[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([holdOrderId])
  // Browse filters by city (case-insensitive exact match) within live
  // listings, and GET /listings/locations groups live listings by city.
  @@index([status, city])
  @@index([pincode])
}

model WishlistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

model Order {
  id                String      @id @default(cuid())
  // Human-readable display id, e.g. "NM-20260730-014" — generated from
  // DailyOrderSequence at creation time. `id` stays the real PK; this is
  // purely for display (admin UI, notifications, customer-facing pages).
  orderNumber       String      @unique
  buyer             User        @relation(fields: [buyerId], references: [id])
  buyerId           String
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod @default(ONLINE)
  totalInPaise      Int
  shippingAddress   Json
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  refundId          String?
  refundedAt        DateTime?
  // One of CancellationPolicy.reasonCodes at the time of cancellation — not
  // a foreign key, since the policy's codes can change afterward.
  cancellationReason String?
  items             OrderItem[]
  reviews           Review[]
  shipments         Shipment[]
  payouts           SellerPayout[]
  heldListings      Listing[]   @relation("ListingHold")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([buyerId])
  @@index([status])
}

// Atomic per-day counter backing Order.orderNumber generation — incremented
// via a raw upsert (INSERT ... ON CONFLICT DO UPDATE ... RETURNING count)
// inside the same transaction as order creation, so concurrent checkouts on
// the same day never collide.
model DailyOrderSequence {
  date  String @id // "YYYYMMDD", UTC
  count Int    @default(0)
}

// Single global row (id is always "global") — admin-editable rules for
// buyer/admin order cancellation. Read by OrdersService.cancel/updateStatus.
model CancellationPolicy {
  id               String   @id @default("global")
  cutoffHours      Int      @default(24)
  reasonCodes      String[] @default(["Changed my mind", "Ordered by mistake", "Found a better price elsewhere", "Seller delay", "Other"])
  refundPercentage Int      @default(100)
  // How long after delivery a buyer may raise a condition dispute ("not as
  // described"). Unlike the fields above this one is NOT enforced anywhere in
  // code — there is no dispute-raising endpoint yet, so it is the published
  // promise on the refunds page only. Wire it into that flow when it exists.
  conditionDisputeHours Int @default(48)
  updatedAt        DateTime @updatedAt
}

// Single global row (id is always "global") — the operator's real business
// identity, required on the legal pages by Indian e-commerce rules and by
// Razorpay's own KYC. The legal pages stay `noindex` with a draft banner
// until every required field here is filled in, so half-finished policies
// can never be published or indexed. Fields start empty on purpose: seeding
// a plausible-looking company name would be worse than an obvious blank.
model BusinessProfile {
  id                    String   @id @default("global")
  legalEntityName       String   @default("")
  tradeName             String   @default("")
  registeredAddress     String   @default("")
  supportEmail          String   @default("")
  supportPhone          String   @default("")
  grievanceOfficerName  String   @default("")
  grievanceOfficerEmail String   @default("")
  // Optional — not every operator is GST-registered or incorporated.
  gstin                 String?
  cin                   String?
  updatedAt             DateTime @updatedAt
}

// Single global row (id is always "global") — the marketplace's commission,
// in basis points so rates like 5.5% (550) need no floats. Read once per sale
// and snapshotted onto each SellerPayout, so changing it never moves money
// that has already been earned.
model PayoutPolicy {
  id            String   @id @default("global")
  commissionBps Int      @default(1000) // 10%
  updatedAt     DateTime @updatedAt
}

model OrderItem {
  id               String  @id @default(cuid())
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  // Restrict: a listing that has been ordered can never be hard-deleted.
  listing          Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingId        String
  listingTitle     String // snapshot at purchase
  sellerId         String // snapshot — who gets paid / notified
  unitPriceInPaise Int // snapshot (selling price)
  image            String?

  @@index([orderId])
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  message   String
  listingId String?
  orderId   String?
  // The user this notification is *about* (not the recipient) — e.g. the
  // seller who just registered, for an admin's SELLER_REGISTERED alert. Only
  // set when there's no listing/order to link to instead.
  relatedUserId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

// A buyer rates the seller of one purchased listing, once per order line.
model Review {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  reviewer   User     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String
  seller     User     @relation("ReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId   String
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([orderId, listingId])
  @@index([sellerId])
  @@index([listingId])
}

// A seller's payment for registration or a membership plan (online only). The
// gateway ids mirror Order's; on settle a MEMBERSHIP payment creates/extends a
// SellerMembership window.
model SellerPayment {
  id               String              @id @default(cuid())
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  type             SellerPaymentType
  plan             MembershipPlan? // set only when type = MEMBERSHIP
  amountInPaise    Int // authoritative amount from the server
  status           SellerPaymentStatus @default(PENDING)
  gatewayOrderId   String?             @unique
  gatewayPaymentId String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId])
}

// A prepaid access window. A seller may list only while some window has
// expiresAt in the future. Buying while active stacks onto the current expiry.
model SellerMembership {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  plan      MembershipPlan
  startsAt  DateTime       @default(now())
  expiresAt DateTime
  createdAt DateTime       @default(now())
  // Set once by MembershipExpiryService so a seller is warned once, not on
  // every sweep. Only ever stamped on the user's latest-expiring row, since
  // stacked purchases mean earlier rows are already superseded.
  expiryWarningSentAt DateTime?
  expiredNoticeSentAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// What the marketplace owes one seller for one order — the ledger behind
// "buyer pays us, we pay the seller". One row per (order, seller), created in
// the same transaction that marks the order PAID, so a settled sale can never
// exist without its corresponding debt. Amounts are snapshots: commissionBps
// is the rate at sale time, and gross = commission + net exactly.
model SellerPayout {
  id                 String       @id @default(cuid())
  // Restrict, not Cascade: this is a money ledger. Cascading would let
  // deleting an order or a seller account silently erase both an outstanding
  // debt and the audit record of a transfer that already went out. Mirrors
  // OrderItem's Restrict on Listing — a row someone was paid for can't be
  // deleted out from under the record.
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId            String
  seller             User         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerId           String
  status             PayoutStatus @default(PENDING)
  grossInPaise       Int
  commissionBps      Int
  commissionInPaise  Int
  netInPaise         Int
  // Transfer reference (UTR / bank ref) recorded by the admin on payout.
  reference          String?
  paidAt             DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([orderId, sellerId])
  @@index([sellerId])
  @@index([status])
}

// One seller's shippable portion of an order (an order may span sellers). The
// seller generates a marketplace label, prints it, and marks it shipped. For a
// courier provider (Shiprocket/…) labelUrl + trackingId hold the AWB; for the
// built-in manual provider the label is rendered on demand and labelGeneratedAt
// records that it was produced.
model Shipment {
  id               String         @id @default(cuid())
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  sellerId         String
  status           ShipmentStatus @default(PENDING)
  courier          String?
  trackingId       String?
  labelUrl         String?
  labelGeneratedAt DateTime?
  shippedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([orderId, sellerId])
  @@index([sellerId])
}

// Admin-authored marketplace journal content (roadmap 4.2). authorName is a
// free-text label, not a User relation — the admin who wrote it doesn't need
// to stay resolvable if their account is later removed.
// The Nurture Journal's taxonomy, fixed by the founders' brief (section 11).
// An enum rather than free text: these are the categories the journal is
// organised around and each one is a page a reader can land on, so a typo in
// the admin form would silently create a category nobody can reach.
enum BlogCategory {
  PREGNANCY
  YOGA
  POSTPARTUM
  NUTRITION
  STARTING_SOLIDS
  BABY
  TODDLER
  MOTHERHOOD
  MOMPRENEUR
  PRELOVED
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  bodyMarkdown  String
  coverImageUrl String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  authorName    String
  // Nullable: every post written before the taxonomy existed has no category,
  // and guessing one for them would be inventing editorial intent.
  category      BlogCategory?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  previousSlugs BlogPostSlug[]

  @@index([published, publishedAt])
  @@index([category, published, publishedAt])
}

// Slugs a post used to live at. Renaming a published post would otherwise turn
// every existing link to it — search results, shares, other sites — into a 404
// with nothing recording where it went. The public lookup falls back to this
// table and the post page 308s to the current slug.
model BlogPostSlug {
  id        String   @id @default(cuid())
  slug      String   @unique
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
}

enum ContactMessageStatus {
  NEW
  READ
  RESPONDED
}

// "Send us a message" submissions from the public contact form (roadmap 4.3).
enum EnquiryService {
  YOGA
  NUTRITION
  STARTING_SOLIDS
  COMMUNITY
  PRELOVED
}

model ContactMessage {
  id               String               @id @default(cuid())
  name             String
  email            String
  phone            String?
  subject          String
  message          String
  status           ContactMessageStatus @default(NEW)
  // Which service page sent this enquiry. Nullable: the footer contact link
  // belongs to no service, and every message predating this column has none
  // — backfilling a guess would invent an attribution nobody recorded.
  service          EnquiryService?
  // The package and price the mother was shown when she enquired, snapshotted
  // server-side at submit time from ServicePackage via resolvePackagePrice —
  // the client sends only packageId, never a price. packageId is a plain
  // column, not a foreign key: a package can be edited or deleted later, and
  // the record of what was quoted has to survive that unchanged.
  packageId        String?
  packageName      String?
  quotedPricePaise Int?
  createdAt        DateTime             @default(now())

  @@index([status])
  @@index([service, createdAt])
}

// ------------------------------------------------------------------
// Redesign content (REDESIGN-PLAN.md phases 1b, 3, 6)
// ------------------------------------------------------------------

// Which pricing block a ServicePackage belongs to on the service pages. A
// fixed enum rather than free text because each group is a section of a
// page in code — a typo in the admin form would create a group nobody renders.
enum ServiceGroup {
  PRENATAL_YOGA
  GARBHASANSKAR
  COMBO // Prenatal Yoga + Garbhasanskar bundled
  ONE_TO_ONE_YOGA
  NUTRITION
  STARTING_SOLIDS
}

enum SessionFormat {
  LIVE_GROUP
  ONE_TO_ONE
  RECORDED
}

// A bookable session package with an admin-editable price. Sessions are not
// paid online: "Book Now" opens WhatsApp / the enquiry form with the package
// and its current price prefilled, and the quoted price is snapshotted onto
// the ContactMessage. What a card shows is always resolvePackagePrice() in
// shared — never these columns read directly — so the card, the WhatsApp
// message and the enquiry snapshot cannot disagree.
model ServicePackage {
  id              String        @id @default(cuid())
  group           ServiceGroup
  name            String // "Monthly Combo"
  summary         String
  includes        String[] // bullet list on the card
  sessionCount    Int?
  // Null until the client confirms durations; the card omits what it lacks.
  sessionMinutes  Int?
  validityDays    Int?
  format          SessionFormat
  pricePaise      Int // the regular price
  // When pricePaise last changed. The service must bump it whenever the
  // regular price changes. Advertising a struck-through "regular" price that
  // was never genuinely charged is forbidden by the brief (§9); software can't
  // prove what was charged, so this date drives a soft admin warning
  // (offerSavingsWarning in shared) instead.
  priceSince      DateTime      @default(now())
  offerPricePaise Int? // must be < pricePaise (validated in shared)
  offerLabel      String? // null → "Special Offer"
  // Past → the offer disappears by itself; null with an offer price set →
  // open-ended offer.
  offerEndsAt     DateTime?
  // "Introductory Price" label, never a strikethrough. Mutually exclusive
  // with an offer (validated in shared and re-checked in the service).
  isIntroductory  Boolean       @default(false)
  isBestValue     Boolean       @default(false)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([group, isActive, sortOrder])
}

// A partner brand discount on the /offers page. Expired rows are filtered out
// by the public API so an expired code can never show by accident.
model PartnerOffer {
  id          String    @id @default(cuid())
  brandName   String
  logoUrl     String?
  description String
  benefit     String // the verified discount, e.g. "15% off your first order"
  couponCode  String?
  url         String // https only (validated in shared)
  // Affiliate links render with rel="sponsored" and an "Affiliate link" chip.
  isAffiliate Boolean   @default(false)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

enum FaqSection {
  GENERAL
  SESSIONS
  NUTRITION
  MARKETPLACE
  PAYMENTS
  DONATIONS
}

// Static FAQ answers. Answers that quote live values (the cancellation window,
// membership prices) are deliberately NOT stored here — the /faq page renders
// those from code, so a stored copy can never contradict what is enforced.
model Faq {
  id          String     @id @default(cuid())
  section     FaqSection
  question    String
  answer      String // markdown
  sortOrder   Int        @default(0)
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([section, isPublished, sortOrder])
}

model Testimonial {
  id               String   @id @default(cuid())
  name             String
  context          String? // "Prenatal yoga · Hyderabad"
  quote            String
  photoUrl         String?
  // The brief forbids publishing a testimonial without the mother's
  // permission. Publishing requires this to be true (validated in shared and
  // re-checked in the service); the public read also filters on it.
  consentConfirmed Boolean  @default(false)
  isPublished      Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// Single global row (id is always "global"), like BusinessProfile — the
// admin-editable copy and links the layout reads. A section whose field is
// null/empty stays hidden, so a placeholder never goes live.
model SiteContent {
  id                   String   @id @default("global")
  heroHeadline         String
  heroSubline          String
  heroMessage          String
  heroImageUrl         String?
  heroImageAlt         String?
  aboutMission         String?
  // [{ name, role, photoUrl?, bio, qualifications: string[] }] — shape
  // validated by siteContentInputSchema in shared. Qualifications must be
  // verified before they are entered; the About page prints them as fact.
  founders             Json     @default("[]")
  // [{ url, alt, caption? }]
  galleryImages        Json     @default("[]")
  instagramUrl         String?
  youtubeUrl           String?
  whatsappCommunityUrl String?
  whatsappPrelovedUrl  String?
  // Markdown: cancellation, rescheduling and refunds for sessions (§10).
  sessionPolicy        String?
  updatedAt            DateTime @updatedAt
}

enum DonationStatus {
  NEW
  CONTACTED
  MATCHED
  COMPLETED
  DECLINED
}

enum HandoverPreference {
  PICKUP
  DROP_OFF
  EITHER
}

// An item a mother offers to donate. Donations are matched by hand by the
// admin — they never appear in the listing grid and are not searchable.
model DonationOffer {
  id               String             @id @default(cuid())
  donor            User               @relation(fields: [donorId], references: [id])
  donorId          String
  // Contact snapshot at submit time — the donor may edit their profile later,
  // and the admin needs the details she actually gave for this offer.
  contactName      String
  contactEmail     String
  contactPhone     String
  city             String
  locality         String?
  pincode          String // never displayed publicly
  // SetNull: deleting a category must not delete the offer behind it.
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId       String?
  itemsDescription String
  condition        Condition
  images           String[]
  handover         HandoverPreference
  status           DonationStatus     @default(NEW)
  adminNote        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([donorId])
}
