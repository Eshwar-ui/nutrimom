{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  // Specs live beside the source but must never reach dist — the built package
  // is what apps/api and apps/web import, and it would otherwise carry test
  // files (and need jest's types) at build time.
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
